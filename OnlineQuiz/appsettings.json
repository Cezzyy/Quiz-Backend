{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Biometric": {
    "UseMockESP32": true,
    "MockSuccessRate": 0.9,
    "MockDelaySeconds": 3,
    "MaxSlots": 127,
    "EnrollmentTimeoutSeconds": 60,
    "VerificationTimeoutSeconds": 30,
    "ESP32": {
      "ConnectionString": "http://192.168.1.100:8080",
      "Timeout": 30000,
      "RetryAttempts": 3
    }
  }
}
