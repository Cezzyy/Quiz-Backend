@OnlineQuiz_HostAddress = http://localhost:5000

GET {{OnlineQuiz_HostAddress}}/api/user
Accept: application/json

###

# ==========================================
# AUTH ENDPOINTS
# ==========================================

### Login to get JWT Token
# @name login
POST {{OnlineQuiz_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@aclc.edu",
  "password": "admin123"
}

###

### Verify Me (Current User Details)
GET {{OnlineQuiz_HostAddress}}/api/auth/verify-me
Authorization: Bearer {{token}}
Accept: application/json

###

### Logout
POST {{OnlineQuiz_HostAddress}}/api/auth/logout
Authorization: Bearer {{token}}
Accept: application/json

###

### Change Password
POST {{OnlineQuiz_HostAddress}}/api/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "Password123!",
  "newPassword": "NewPassword123!"
}

###

# ==========================================
# BIOMETRIC ENDPOINTS
# ==========================================

# Biometric JWT Token
@token = your_jwt_token_here
@userId = 1

### Start fingerprint enrollment for a user (Teacher/Admin only)
POST {{OnlineQuiz_HostAddress}}/api/biometric/enroll/{{userId}}
Authorization: Bearer {{token}}
Accept: application/json

###

### Remove fingerprint enrollment for a user (Teacher/Admin only)
DELETE {{OnlineQuiz_HostAddress}}/api/biometric/unenroll/{{userId}}
Authorization: Bearer {{token}}
Accept: application/json

###

### Start fingerprint verification for a user 
POST {{OnlineQuiz_HostAddress}}/api/biometric/verify/{{userId}}
# Alternatively with quizId
# POST {{OnlineQuiz_HostAddress}}/api/biometric/verify/{{userId}}?quizId=2
Authorization: Bearer {{token}}
Accept: application/json

###

### Get ESP32 device status
GET {{OnlineQuiz_HostAddress}}/api/biometric/status
Authorization: Bearer {{token}}
Accept: application/json

###

### Get available fingerprint slots (Teacher/Admin only)
GET {{OnlineQuiz_HostAddress}}/api/biometric/available-slots
Authorization: Bearer {{token}}
Accept: application/json

###

### Check if a user has fingerprint enrolled
GET {{OnlineQuiz_HostAddress}}/api/biometric/is-enrolled/{{userId}}
Authorization: Bearer {{token}}
Accept: application/json

###

### Get biometric audit logs
GET {{OnlineQuiz_HostAddress}}/api/biometric/logs?page=1&pageSize=10
Authorization: Bearer {{token}}
Accept: application/json

###

### Cancel current biometric operation
POST {{OnlineQuiz_HostAddress}}/api/biometric/cancel
Authorization: Bearer {{token}}
Accept: application/json

###


